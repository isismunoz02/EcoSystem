@page "/productos"
@using EcoSystem.Client.Models
@using Microsoft.JSInterop
@inject EcoSystem.Client.Services.ApiService ApiService
@inject IJSRuntime JSRuntime

<h1>EcoSystem Connect · Firma 5</h1>
<p>CRUD de Productos desde Blazor</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="success">@mensaje</p>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}

<div class="crud-container">
    <div class="crud-form">
        <h3>@(modoEdicion ? "Actualizar producto" : "Crear producto")</h3>

        <label>Nombre</label>
        <input class="form-control" @bind="productoForm.Nombre" />

        <label>Descripción</label>
        <input class="form-control" @bind="productoForm.Descripcion" />

        <label>Precio</label>
        <input class="form-control" type="number" step="0.01" @bind="productoForm.Precio" />

        <label>Stock</label>
        <input class="form-control" type="number" @bind="productoForm.Stock" />

        <label>SKU</label>
        <input class="form-control" @bind="productoForm.SKU" />

        <label>Categoría ID</label>
        <input class="form-control" type="number" @bind="productoForm.CategoriaId" />

        <button class="btn-primary" @onclick="GuardarProducto" disabled="@cargando">
            @(cargando ? "Guardando..." : modoEdicion ? "Actualizar" : "Guardar")
        </button>

        @if (modoEdicion)
        {
            <button class="btn-secondary" @onclick="CancelarEdicion">
                Cancelar edición
            </button>
        }
    </div>

    <div class="crud-list">
        <h3>Lista de productos</h3>

        @if (productos is null)
        {
            <p>Cargando productos...</p>
        }
        else if (productos.Count == 0)
        {
            <p>No hay productos registrados.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>SKU</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td>@producto.Id</td>
                            <td>@producto.Nombre</td>
                            <td>$@producto.Precio</td>
                            <td>@producto.Stock</td>
                            <td>@producto.SKU</td>
                            <td>
                                <button class="btn-edit" @onclick="() => EditarProducto(producto)">
                                    Editar
                                </button>

                                <button class="btn-delete" @onclick="() => EliminarProducto(producto.Id)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<Producto>? productos;
    private Producto productoForm = new();
    private bool modoEdicion = false;
    private bool cargando = false;
    private string mensaje = string.Empty;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        productos = await ApiService.GetProductosAsync();
    }

    private async Task GuardarProducto()
    {
        mensaje = string.Empty;
        error = string.Empty;

        if (string.IsNullOrWhiteSpace(productoForm.Nombre))
        {
            error = "El nombre del producto es obligatorio.";
            return;
        }

        if (productoForm.Precio <= 0)
        {
            error = "El precio debe ser mayor a 0.";
            return;
        }

        cargando = true;

        try
        {
            if (modoEdicion)
            {
                var actualizado = await ApiService.ActualizarProductoAsync(productoForm.Id, productoForm);

                mensaje = actualizado
                    ? "Producto actualizado correctamente."
                    : "No se pudo actualizar el producto.";
            }
            else
            {
                var creado = await ApiService.CrearProductoAsync(productoForm);

                mensaje = creado is not null
                    ? "Producto creado correctamente."
                    : "No se pudo crear el producto.";
            }

            LimpiarFormulario();
            await CargarProductos();
        }
        finally
        {
            cargando = false;
        }
    }

    private void EditarProducto(Producto producto)
    {
        modoEdicion = true;

        productoForm = new Producto
        {
            Id = producto.Id,
            CategoriaId = producto.CategoriaId,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            Precio = producto.Precio,
            Stock = producto.Stock,
            SKU = producto.SKU
        };

        mensaje = string.Empty;
        error = string.Empty;
    }

    private async Task EliminarProducto(int id)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            "¿Seguro que deseas eliminar este producto?"
        );

        if (!confirmado)
            return;

        var eliminado = await ApiService.EliminarProductoAsync(id);

        if (eliminado)
        {
            mensaje = "Producto eliminado correctamente.";
            error = string.Empty;
            await CargarProductos();
        }
        else
        {
            error = "No se pudo eliminar el producto.";
            mensaje = string.Empty;
        }
    }

    private void CancelarEdicion()
    {
        LimpiarFormulario();
        mensaje = string.Empty;
        error = string.Empty;
    }

    private void LimpiarFormulario()
    {
        productoForm = new Producto();
        modoEdicion = false;
    }
}